{
  "name": "clausage-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w @clausage/core && npm run build -w clausage",
    "cli": "node packages/cli/dist/index.js",
    "dev": "npm run dev -w web",
    "test": "npm test -w @clausage/core && npm test -w web"
  },
  "devDependencies": {
    "@types/node": "^24.19.2"
  }
}
